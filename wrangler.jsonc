{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pageview-logger",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pageviews-db",
      "database_id": "38c13894-511b-4786-af36-2c2a2cd166d2"
    }
  ],

  "vars": {
    "PAGE_URL": "https://shoaibakthar.pro",
    "LOG_KEY": "pv_8a7b3c9d2e1f4a6b8c0d2e4f6a8b0c2d",
    "ALLOWED_ORIGINS": "https://shoaibsprojects.github.io,https://shoaibakthar.pro,http://localhost"
  },

  "triggers": {
    "crons": ["0 3 * * *"]
  }
}