{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pageview-logger",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pageviews-db",
      "database_id": "38c13894-511b-4786-af36-2c2a2cd166d2"
    }
  ],

  "vars": {
    "PAGE_URL": "https://shoaibakthar.pro",
    "ALLOWED_ORIGINS": "https://shoaibsprojects.github.io,https://shoaibakthar.pro,http://localhost",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEEnNekKas-hBHMPRHpw37HGb_c"
    // Uncomment to auto-purge old records (recommended: 90). Off by default.
    // "RETAIN_DAYS": "90"
  },

  "triggers": {
    "crons": ["0 3 * * *"]
  }
}