{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pageview-logger",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pageviews-db",
      "database_id": "38c13894-511b-4786-af36-2c2a2cd166d2"
    }
  ],

  // Fast per-location gate: reject event floods before the D1-backed limiter
  // and analytics insert can consume database writes. D1 remains a secondary
  // cross-request guard; Cloudflare's binding is approximate, not global accounting.
  "ratelimits": [
    {
      "name": "EVENT_INGEST_LIMITER",
      "namespace_id": "964567313391115",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  "vars": {
    "PAGE_URL": "https://shoaibakthar.pro",
    "ALLOWED_ORIGINS": "https://shoaibsprojects.github.io,https://shoaibakthar.pro,http://localhost",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEEnNXNege0uqc_0"
    // Uncomment to auto-purge old records (recommended: 90). Off by default.
    // "RETAIN_DAYS": "90"
  },

  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
